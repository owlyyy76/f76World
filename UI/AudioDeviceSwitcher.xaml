using System.Windows;
using System.Windows.Controls;
using System.Windows.Media;
using f76World.AudioRouting;

namespace f76World.UI
{
    public partial class AudioDeviceSwitcher : UserControl
    {
        private readonly MojaveAudioSentinel _audioSentinel;

        public AudioDeviceSwitcher()
        {
            InitializeComponent();
            
            // In a real DI setup, this would be injected.
            _audioSentinel = new MojaveAudioSentinel();
            _audioSentinel.OnRelayStateChanged += UpdateUIState;
            _audioSentinel.OnError += HandleAudioError;

            RefreshDeviceList();
        }

        private void RefreshDeviceList()
        {
            var devices = _audioSentinel.GetAvailablePhysicalDevices();
            DeviceComboBox.ItemsSource = devices;
            
            if (devices.Count > 0 && DeviceComboBox.SelectedIndex == -1)
            {
                DeviceComboBox.SelectedIndex = 0;
            }
        }

        private void DeviceComboBox_DropDownOpened(object sender, System.EventArgs e)
        {
            // Refresh list dynamically when user opens the dropdown (in case they just plugged in headphones)
            RefreshDeviceList();
        }

        private void ApplyRoutingBtn_Click(object sender, RoutedEventArgs e)
        {
            if (DeviceComboBox.SelectedValue is string selectedDeviceId)
            {
                _audioSentinel.RouteAudioToDevice(selectedDeviceId);
            }
        }

        private void RestartAudioBtn_Click(object sender, RoutedEventArgs e)
        {
            // Forcefully restarts the WASAPI loopback without changing the endpoint
            _audioSentinel.RestartRelay();
        }

        private void UpdateUIState()
        {
            Dispatcher.Invoke(() =>
            {
                if (_audioSentinel.IsRelayActive)
                {
                    StatusIndicator.Fill = new SolidColorBrush((Color)ColorConverter.ConvertFromString("#a6e3a1")); // Green
                    StatusText.Text = "Active & Shielding F76";
                }
                else
                {
                    StatusIndicator.Fill = new SolidColorBrush((Color)ColorConverter.ConvertFromString("#f38ba8")); // Red
                    StatusText.Text = "Offline";
                }
            });
        }

        private void HandleAudioError(string errorMessage)
        {
            Dispatcher.Invoke(() =>
            {
                MessageBox.Show($"Audio Sentinel Error:\n{errorMessage}", "F76.World Audio Shield", MessageBoxButton.OK, MessageBoxImage.Error);
                UpdateUIState();
            });
        }
    }
}