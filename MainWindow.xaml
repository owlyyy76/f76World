<Window x:Class="f76World.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Windows Optimizer (PRO)" Height="820" Width="950"
        MinHeight="650" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- NAPRAWIONY XDG BUG: Czysty, bezbłędny styl przycisków NeonButton -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nowoczesne TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,15,0,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="20,10" Margin="0,0,10,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A1F2E"/>
                                <Setter Property="Foreground" Value="#00E676"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- GŁÓWNE ZAAOKRĄGLONE OKNO -->
    <Border Background="#0B0D14" CornerRadius="12" BorderBrush="#1F2536" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- PASEK TYTUŁOWY (Draggable) -->
            <Border Grid.Row="0" Background="#0F131D" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="☢️ F76.WORLD" Foreground="#00E676" FontSize="18" FontWeight="Black" Margin="0,0,10,0"/>
                        <TextBlock Text="Universal Optimizer" Foreground="#BDC3C7" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="  |  by Owlyyy 🦉" Foreground="#9B59B6" FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                        <ComboBox x:Name="LangCombo" SelectionChanged="LangCombo_SelectionChanged" Width="110" Margin="0,0,15,0" Height="28" 
                                  Background="#161A25" Foreground="#00E676" BorderBrush="#2C3E50" BorderThickness="1" Cursor="Hand">
                            <ComboBoxItem Content="English" Background="#BDC3C7" Foreground="White"/>
                            <ComboBoxItem Content="Polski" Background="#BDC3C7" Foreground="White"/>
                        </ComboBox>
                        <Button Click="BtnMinimize_Click" Content="—" Width="30" Height="30" Background="Transparent" Foreground="#BDC3C7" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                        <Button Click="BtnClose_Click" Content="✕" Width="30" Height="30" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ZAWARTOŚĆ GŁÓWNA -->
            <Grid Grid.Row="1" Margin="25,15,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150" MinHeight="80" MaxHeight="350"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#121621" CornerRadius="6" BorderBrush="#1C2130" BorderThickness="1" Padding="15,10" Margin="0,0,15,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🌐 MESSAGE OF THE DAY" Foreground="#F39C12" FontSize="11" FontWeight="Black" Margin="0,0,0,3"/>
                            <TextBlock x:Name="LblMotd" Text="Connecting to Promethean Resonance Matrix... Awaiting orders." Foreground="#BDC3C7" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnUpdate" Grid.Column="1" Click="BtnUpdate_Click" Content="🔄 Check for Updates" Style="{StaticResource NeonButton}" Background="#2980B9" Padding="20,10" VerticalAlignment="Stretch"/>
                </Grid>

                <TabControl Grid.Row="1" Margin="0,0,0,5">
                    <TabItem x:Name="TabTweaks" Header="⚙️ Tweaks &amp; Installers">
                        <Grid Margin="0,15,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="BtnAnalyze" Grid.Row="0" Click="BtnAnalyze_Click" Content="🔍 Analyze System Status" Style="{StaticResource NeonButton}" Background="#F39C12" Padding="20,12" Margin="0,0,0,15"/>

                            <Border Grid.Row="1" Background="#121621" CornerRadius="8" BorderBrush="#1C2130" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Automation &amp; System Integration" Foreground="#E74C3C" FontSize="18" FontWeight="Black" Margin="0,0,0,15"/>
                                        <CheckBox x:Name="ChkAutoUpdate" Content="Check for updates automatically on startup" IsChecked="True" Foreground="#BDC3C7" FontSize="14" FontWeight="Bold" Margin="0,5"/>
                                        <CheckBox x:Name="ChkAutoStart" Checked="ChkAutoStart_Checked" Unchecked="ChkAutoStart_Unchecked" Content="Run natively on Windows boot (Highest Privileges Task)" Foreground="#BDC3C7" FontSize="14" FontWeight="Bold" Margin="0,5"/>

                                        <Rectangle Height="1" Fill="#1C2130" Margin="0,25,0,25"/>

                                        <TextBlock x:Name="LblSecTweaks" Text="Kernel &amp; Performance Latency" Foreground="#3498DB" FontSize="18" FontWeight="Black" Margin="0,0,0,15"/>
                                        <StackPanel x:Name="TweaksContainer" Margin="0,0,0,30"/>

                                        <TextBlock x:Name="LblSecInstall" Text="Required Architecture Packages" Foreground="#9B59B6" FontSize="18" FontWeight="Black" Margin="0,0,0,15"/>
                                        <StackPanel x:Name="InstallersContainer"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Button x:Name="BtnRun" Grid.Row="2" Click="BtnRun_Click" Content="⚡ Execute Checked Operations" Style="{StaticResource NeonButton}" Background="#00C853" FontSize="18" Padding="20,15" Margin="0,15,0,0"/>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="TabRescue" Header="🚑 Rescue Diagnostics">
                        <Border Background="#121621" CornerRadius="8" BorderBrush="#1C2130" BorderThickness="1" Margin="0,15,0,0" Padding="40">
                            <StackPanel VerticalAlignment="Center" MaxWidth="500">
                                <TextBlock x:Name="LblRescue" Text="Emergency Tools &amp; Restoration" Foreground="White" FontSize="22" FontWeight="Black" TextAlignment="Center" Margin="0,0,0,30"/>
                                <Button x:Name="BtnKill" Click="BtnKill_Click" Content="💀 Kill Hung Applications Immediately" Style="{StaticResource NeonButton}" Background="#E74C3C" Padding="15,15" Margin="0,0,0,15"/>
                                <Button x:Name="BtnMenu" Click="BtnMenu_Click" Content="➕ Add Rescue Options to Desktop Context Menu" Style="{StaticResource NeonButton}" Background="#8E44AD" Padding="15,15" Margin="0,0,0,15"/>
                                <Button x:Name="BtnReport" Click="BtnReport_Click" Content="📊 Generate System &amp; Driver Report" Style="{StaticResource NeonButton}" Background="#2980B9" Padding="15,15"/>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#1C2130" Margin="0,5" Cursor="SizeNS"/>

                <Border Grid.Row="3" Background="#06080C" BorderBrush="#1C2130" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="TERMINAL OUTPUT" Foreground="#34495E" FontSize="10" FontWeight="Bold" Margin="10,5,0,0"/>
                        <TextBox x:Name="LogConsole" Foreground="#00E676" Background="Transparent" FontFamily="Consolas" FontSize="13" BorderThickness="0" Padding="15,25,15,15" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>