<Window x:Class="ProjectF76World.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BetterF76 Launcher - The Administrator" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="F76.WORLD TACTICAL HUB" Foreground="#00FF00" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <!-- Tier 2: Registry Optimizations -->
            <Button Content="Wyłącz MPO (Multi-Plane Overlay)" Height="40" Margin="0,5" Click="OnDisableMpoClick" 
                    Background="#333333" Foreground="White" BorderBrush="#555555"/>

            <!-- Tier 3: VRAM / RAM P/Invoke Clear -->
            <Button Content="Zwolnij VRAM/RAM (Tło)" Height="40" Margin="0,5" Click="OnClearMemoryClick" 
                    Background="#333333" Foreground="White" BorderBrush="#555555"/>

            <!-- Rollback -->
            <Button Content="Przywróć Rejestr (Rollback)" Height="40" Margin="0,25,0,5" Click="OnRollbackClick" 
                    Background="#8B0000" Foreground="White" BorderBrush="#FF4500"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Auto-Updater aktywny. Gotowy do gry." Foreground="#888888" HorizontalAlignment="Center"/>
    </Grid>
</Window>